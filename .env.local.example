# ============================================================================
# 필수 - Supabase (로그인 + DB)
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxx

# 자동 동기화(Cron)/카카오 알림 등 로그인 세션 없이 서버에서 DB 쓰기 위한 관리자 키
# Supabase 대시보드 -> Project Settings -> API -> service_role 키 (secret) 복사
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxx


# ============================================================================
# AI - 소싱 추천 / 판매 전략 / 상세페이지 카피 (lib/ai.ts)
# ============================================================================
# Anthropic Console (console.anthropic.com) 에서 발급
ANTHROPIC_API_KEY=

# ============================================================================
# AI - 원본 이미지 중국어 번역(OCR+합성) / 썸네일·상세페이지 이미지 생성
# (lib/imageProcessing.ts)
# ============================================================================
# Google AI Studio (aistudio.google.com) 에서 발급
GEMINI_API_KEY=

# 모델명이 바뀌는 경우가 있어서 필요하면 오버라이드 (기본값은 코드에 있음)
# GEMINI_VISION_MODEL=gemini-3.6-flash
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# 누끼(배경 제거) - remove.bg (remove.bg/api 에서 발급)
REMOVE_BG_API_KEY=


# ============================================================================
# Bright Data Web Unlocker - 쿠팡/알리바바 실시간 스크래핑 (lib/brightdata.ts)
# ============================================================================
# brightdata.com 대시보드에서 발급
BRIGHTDATA_API_KEY=
BRIGHTDATA_UNLOCKER_ZONE=


# ============================================================================
# 쿠팡 오픈API - 재고/주문 연동 (lib/coupang.ts, lib/coupangSync.ts)
# ============================================================================
# accessKey/secretKey 자체는 앱 화면(재고관리 > 채널 연동)에서 입력해서
# DB(channel_credentials)에 저장하므로 여기엔 없음.

# 쿠팡 API는 등록된 고정 IP에서만 호출을 허용하는데, Vercel은 아웃바운드 IP가
# 매번 랜덤이라 고정 IP 프록시(Fixie 등)를 거쳐야 했음. 맥북 자체 호스팅으로
# 옮기면 맥북의 IP가 고정이라 이 프록시가 필요 없어질 수 있음 - 실제 호출
# 성공 여부로 확인 후 없어도 되면 비워두면 됨.
# COUPANG_PROXY_URL=

# 외부 무료 스케줄러(cron-job.org 등)로 /api/cron/sync-coupang* 를 호출할 때
# 인증용으로 쓰는 비밀값. 아무 문자열이나 직접 정해서 넣으면 되고, 스케줄러
# 설정의 URL 쿼리(?secret=...)와 반드시 같은 값이어야 함.
COUPANG_SYNC_SECRET=여기에_직접_정한_비밀값

# /api/cron/sync-coupang 는 위 COUPANG_SYNC_SECRET(쿼리) 대신 Authorization
# 헤더(Bearer 토큰) 방식도 지원함 - Vercel Cron처럼 쿼리 대신 헤더로 인증하는
# 스케줄러를 쓸 때만 필요, 안 쓰면 비워둬도 됨.
# CRON_SECRET=


# ============================================================================
# 네이버 오픈API - 네이버쇼핑 연동 (lib/naver.ts)
# ============================================================================
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=


# ============================================================================
# 카카오 - "나에게 보내기" 알림 (lib/kakao.ts, app/api/kakao/*)
# ============================================================================
# 카카오 개발자센터(developers.kakao.com) 앱의 REST API 키 / Client Secret.
# ⚠️ 비즈 앱 검수 안 받은 앱이라 카카오 개발자센터에 "팀원"으로 등록된
# 계정만 로그인/메시지 전송 가능.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 카카오 로그인 콜백 redirect_uri + "나에게 보내기" 메시지에 들어가는 링크에
# 쓰는 이 앱의 실제 접속 주소. 도메인이 바뀌면(맥북 자체 호스팅 등) 여기 값만
# 바꾸면 되고, 카카오 개발자센터 Redirect URI 등록도 같이 바꿔야 함.
# 안 채우면 기본값(https://hion.vercel.app)으로 동작함.
NEXT_PUBLIC_APP_URL=https://hion.vercel.app


# ============================================================================
# 웹푸시(PWA) 알림 (lib/webpush.ts)
# ============================================================================
# web-push 라이브러리의 `npx web-push generate-vapid-keys`로 생성
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
